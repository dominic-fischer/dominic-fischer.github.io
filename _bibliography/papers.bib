@inproceedings{volk2024llm,
  author    = {Volk, Martin and Fischer, Dominic P and Fischer, Lukas and Scheurer, Patricia and Str{\"o}bel, Phillip and Sprugnoli, Rachele and Passarotti, Marco},
  title     = {{LLM-based Machine Translation and Summarization for Latin}},
  booktitle = {Proceedings of the Third Workshop on Language Technologies for Historical and Ancient Languages (LT4HALA) at LREC/COLING 2024},
  year      = {2024},
  address   = {Torino, Italy},
  month     = {May},
  publisher = {University of Zurich},
  doi = {10.5167/uzh-259369},
  selected  = {true},
  abstract = {This paper presents an evaluation of machine translation for Latin. We tested multilingual Large Language Models, in particular GPT-4, on letters from the 16th century that are in Latin and Early New High German. Our experiments include translation and cross-language summarization for the two historical languages into modern English and German. We show that LLM-based translation for Latin is clearly superior to previous approaches. We also show that LLM-based paraphrasing of Latin paragraphs from the historical letters produces English and German summaries that are close to human summaries published in the edition.},
  google_scholar_id = {d1gkVwhDpl0C},
  pdf = {LREC_2024_MT_for_Latin.pdf},
}

@inproceedings{volk2024llm,
  author    = {Volk, Martin and Fischer, Dominic P and Scheurer, Patricia and Schwitter, Raphael and Str{\"o}bel, Phillip},
  title     = {LLM-based Translation Across 500 Years. The Case for Early New High German},
  booktitle = {Proceedings of the 20th Conference on Natural Language Processing (KONVENS 2024)},
  year      = {2024},
  address   = {Vienna, Austria},
  month     = {September},
  organization = {Association for Computational Linguistics},
  publisher = {University of Zurich},
  doi = {https://doi.org/10.5167/uzh-262810},
  google_scholar_id = {u-x6o8ySG0sC},
  selected  = {true},
  abstract = {The recently developed large language models (LLMs) show surprising translation capabilities for modern languages. In contrast, this paper investigates the ability of GPT-4 and Gemini to translate 500-year-old letters from Early New High German into modern German. We experiment with a corpus from the 16th century that is partly in Latin and partly in ENH-German. This corpus consists of more than 3000 letters that have been edited and annotated by experts from the Institute of Swiss Reformation Studies. We exploit their annotations for the evaluation of machine translation from ENH-German to German. Our experiments show that using the lexical footnotes by the editors in the prompts or directly injected into the text leads to high quality translations.},
  pdf = {2024.konvens_main.37.pdf},
  poster = {PosterKONVENS.pdf},
}

@inproceedings{fischer2025llm,
  author={Fischer, Dominic P and Volk, Martin},
  title={LLM-based Translation for Latin: Summaries Improve Machine Translation},
  booktitle={Proceedings of the Swiss Text Analytics Conference},
  year={2025},
  address   = {Winterthur, Switzerland},
  month     = {May},
  organization={Association for Computational Linguistics},
  publisher = {University of Zurich},
  doi = {https://doi.org/10.5167/uzh-279356},
  google_scholar_id = {2osOgNQ5qMEC},
  selected  = {false},
  abstract = {Recent studies demonstrated that modern Large Language Models set a new state-of-the-art in translating historical Latin texts into English and German. Building upon this foundation, we investigate the impact of incorporating text summaries into prompts for LLM-based translation tasks. Having both the historical text and a modern-language summary is a typical setup for classical editions. Our findings reveal that integrating summaries significantly enhances translation accuracy and coherence.},
  pdf = {SwissText_2025_Summaries_Improve_Translation.pdf},
  poster = {Poster_SwissText.pdf},
}

@inproceedings{fischer2025name,
  author={Fischer, Dominic P and Volk, Martin},
  title={Name Consistency in LLM-based Machine Translation of Historical Texts},
  booktitle={Proceedings of Machine Translation Summit XX: Volume 1},
  year={2025},
  address   = {Geneva, Switzerland},
  month     = {June},
  organization={Association for Computational Linguistics},
  publisher = {University of Zurich},
  doi = {https://doi.org/10.5167/uzh-279357},
  google_scholar_id = {9yKSN-GCB0IC},
  selected  = {false},
  abstract = {Large Language Models (LLMs) excel at translating 16th-century letters from Latin and Early New High German to modern English and German. While they perform well at translating well-known historical city names (eg, Lutetia–> Paris), their ability to handle person names (eg, Theodor Bibliander) or lesser-known toponyms (eg, Augusta Vindelicorum–> Augsburg) remains unclear. This study investigates LLM-based translations of person and place names across various frequency bands in a corpus of 16th-century letters. Our results show that LLMs struggle with person names, achieving accuracies around 60%, but perform better with place names, reaching accuracies around 90%. We further demonstrate that including a translation suggestion for the proper noun in the prompt substantially boosts accuracy, yielding highly reliable results.},
  pdf = {2025.mtsummit-1.16.pdf},
  slides = {MT_Summit_2025_Name_Translation_Presentation.pptx},
}